# Supabase - Get these from https://supabase.com/dashboard → Settings → API Keys
# Use .env or .env.local (either works). Restart `npm run dev` after changes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Publishable key (sb_publishable_...) — safe for the browser. Replaces the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Secret key (sb_secret_...) — server-only. Never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY=your-secret-key

# After adding credentials, run the case studies migration in Supabase SQL Editor:
# supabase/migrations/20250309000000_create_case_studies.sql

# Gemini - Get this from your Google Cloud Console
GEMINI_API_KEY=your-gemini-api-key
